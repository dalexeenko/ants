{
  "name": "@ants/agent-react-native",
  "version": "0.1.0",
  "description": "React Native bundle package for Ants Agent - combines all RN-compatible packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ants/agent-auth-core": "workspace:*",
    "@ants/agent-auth-react-native": "workspace:*",
    "@ants/agent-core": "workspace:*",
    "@ants/agent-database-core": "workspace:*",
    "@ants/agent-database-react-native": "workspace:*",
    "@ants/agent-providers": "workspace:*",
    "@ants/agent-storage": "workspace:*",
    "@ants/agent-tools": "workspace:*",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "expo-auth-session": ">=5.0.0",
    "expo-crypto": ">=12.0.0",
    "expo-secure-store": ">=12.0.0",
    "expo-sqlite": ">=14.0.0",
    "expo-web-browser": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": false
    },
    "expo-auth-session": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "ants",
    "agent",
    "react-native",
    "expo",
    "ai",
    "anthropic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ants/agent.git",
    "directory": "packages/react-native"
  }
}
